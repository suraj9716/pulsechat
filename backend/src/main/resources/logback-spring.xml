<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <property name="CONSOLE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="com.anochat" level="INFO"/>
    <logger name="org.springframework.web.socket" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>

    <!-- Console only — Render/cloud has no writable logs/ directory -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
